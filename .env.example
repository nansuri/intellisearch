# App
APP_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:5173
FRONTEND_PORT=80

# PostgreSQL
DB_DRIVER=sqlite
DB_SQLITE_PATH=./backend/data/intellisearch.db
DB_HOST=postgres
DB_PORT=5432
DB_USER=aimain
DB_PASSWORD=aimain
DB_NAME=aimain
DB_SSLMODE=disable
# Production only: external Docker network that hosts the shared PostgreSQL
# container (the api service in docker-compose.prod.yml attaches to it).
# SHARED_DB_NETWORK=my-stack_intellisearch_network

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# Auth & secrets
JWT_SECRET=change-me-32-chars-min
JWT_TTL_HOURS=24
ENCRYPTION_KEY=change-me-32-byte-key-for-aes-gcm
SUPER_OWNER_EMAIL=owner@example.com
SUPER_OWNER_PASSWORD=change-me

# AI
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
# Production only: external Docker network with the existing Ollama container
# (e.g. the Open WebUI network). docker-compose.prod.yml attaches the api
# service to it; no Ollama is deployed by this stack.
# OLLAMA_NETWORK=open-webui_default
OPENAI_BASE_URL=
OPENAI_API_KEY=
AI_MODEL=llama3.2

# Search & crawler
# Host-run local dev reaches SearXNG through run-local.sh (host 8081 -> container 8080).
# Docker Compose overrides this to the internal http://searxng:8080 service name for the API container.
SEARXNG_BASE_URL=http://localhost:8081
SEARXNG_TIMEOUT_MS=10000
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT_MS=5000
# Host-run local dev reaches the crawler through run-local.sh (host 3001 -> container 3000).
# Docker Compose overrides this to the internal http://crawler:3000 service name for the API container.
CRAWLER_BASE_URL=http://localhost:3001
CRAWLER_TIMEOUT_MS=15000
CRAWL_TOP_N=3

# Frontend
VITE_API_BASE_URL=/api/v1
